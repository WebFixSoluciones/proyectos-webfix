rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo personal con sesión iniciada por correo/contraseña (no anónimos).
    function esPersonalAutorizado() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // El rol privilegiado se obtiene exclusivamente del perfil protegido.
    function esSuperAdmin() {
      return esPersonalAutorizado()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Valida si el usuario autenticado pertenece a un tenant determinado
    function userBelongsToTenant(tenantId) {
      return esPersonalAutorizado() && (
        esSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId)
      );
    }

    function tenantVerified(tenantId) {
      return esSuperAdmin() || (
        exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
        (!('requireEmailVerification' in get(/databases/$(database)/documents/tenants/$(tenantId)).data) ||
         get(/databases/$(database)/documents/tenants/$(tenantId)).data.requireEmailVerification != true ||
         request.auth.token.email_verified == true)
      );
    }

    function isTenantAdmin(tenantId) {
      return esPersonalAutorizado() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active' &&
        tenantVerified(tenantId) && tenantCanWrite(tenantId);
    }

    function tenantCanWrite(tenantId) {
      return (userBelongsToTenant(tenantId) && tenantVerified(tenantId) && (
        esSuperAdmin() ||
        (exists(/databases/$(database)/documents/tenants/$(tenantId)) && (
          (get(/databases/$(database)/documents/tenants/$(tenantId)).data.planStatus == 'active' &&
           'subscriptionExpiresAt' in get(/databases/$(database)/documents/tenants/$(tenantId)).data &&
           get(/databases/$(database)/documents/tenants/$(tenantId)).data.subscriptionExpiresAt > request.time) ||
          (get(/databases/$(database)/documents/tenants/$(tenantId)).data.planStatus == 'trial' &&
           'trialExpiresAt' in get(/databases/$(database)/documents/tenants/$(tenantId)).data &&
           get(/databases/$(database)/documents/tenants/$(tenantId)).data.trialExpiresAt > request.time)
        )))) ||
        (esPersonalAutorizado() &&
         !exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid &&
         getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId);
    }

    // 1. Sandbox de Inquilinos (Aislamiento Multi-tenant)
    match /artifacts/{appId}/public/data/finances_transactions/{docId} {
      // El visor RIDE público usa la API que devuelve sólo los datos del comprobante.
      allow read: if userBelongsToTenant(appId) && tenantVerified(appId);
      // Escritura restringida estrictamente al tenant correspondiente o superadmin
      allow write: if tenantCanWrite(appId);
    }

    // Configuración fiscal y certificados digitales (.p12, contraseñas, SMTP)
    // NUNCA pública: sólo accesible por el personal autorizado del tenant o superadmin
    match /artifacts/{appId}/public/data/finances_settings/config {
      allow read: if userBelongsToTenant(appId) && tenantVerified(appId);
      allow write: if tenantCanWrite(appId);
    }

    // Resto de datos del tenant (inventario, cotizaciones, ajustes)
    match /artifacts/{appId}/public/data/{document=**} {
      allow read: if userBelongsToTenant(appId) && tenantVerified(appId);
      allow write: if tenantCanWrite(appId);
    }

    // Colecciones del Módulo de Control Financiero (fin_*)
    // Aislamiento multi-tenant estricto: cada documento pertenece a un tenantId
    function canAccessFinDocument() {
      return esSuperAdmin() || (
        esPersonalAutorizado() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        tenantVerified(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId) && (
          (resource == null || ('tenantId' in resource.data && resource.data.tenantId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId)) &&
          (request.resource == null || ('tenantId' in request.resource.data && request.resource.data.tenantId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId))
        )
      );
    }

    function canWriteFinDocument() {
      return canAccessFinDocument() && (
        esSuperAdmin() ||
        tenantCanWrite(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId)
      );
    }

    match /fin_movimientos/{id} {
      allow read: if canAccessFinDocument();
      allow write: if canWriteFinDocument();
    }
    match /fin_movimientos_bancarios/{id} {
      allow read: if canAccessFinDocument();
      allow write: if canWriteFinDocument();
    }
    match /fin_bancos/{id} {
      allow read: if canAccessFinDocument();
      allow write: if canWriteFinDocument();
    }
    match /fin_tarjetas/{id} {
      allow read: if canAccessFinDocument();
      allow write: if canWriteFinDocument();
    }
    match /fin_consumos_tarjeta/{id} {
      allow read: if canAccessFinDocument();
      allow write: if canWriteFinDocument();
    }
    match /fin_prestamos/{id} {
      allow read: if canAccessFinDocument();
      allow write: if canWriteFinDocument();
    }
    match /fin_capturas/{id} {
      allow read: if canAccessFinDocument();
      allow write: if canWriteFinDocument();
    }
    match /fin_cuentas/{id} {
      allow read: if canAccessFinDocument();
      allow write: if canWriteFinDocument();
    }
    match /fin_centros_costo/{id} {
      allow read: if canAccessFinDocument();
      allow write: if canWriteFinDocument();
    }
    match /fin_asientos/{id} {
      allow read: if canAccessFinDocument();
      allow write: if canWriteFinDocument();
    }
    match /fin_auditoria/{id} {
      allow read: if canAccessFinDocument();
      allow write: if canWriteFinDocument();
    }
    match /fin_cxc/{id} {
      allow read: if canAccessFinDocument();
      allow write: if canWriteFinDocument();
    }
    match /fin_cxp/{id} {
      allow read: if canAccessFinDocument();
      allow write: if canWriteFinDocument();
    }

    // 2. Colección de Usuarios (Cierre de escalada de privilegios)
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || esSuperAdmin() ||
        isTenantAdmin(resource.data.tenantId);
      // El alta pública solo crea al propietario de un tenant nuevo en el mismo batch.
      allow create: if esSuperAdmin() || (
        request.resource.data.uid == uid &&
        request.resource.data.role in ['admin', 'staff'] &&
        request.resource.data.status == 'active' &&
        isTenantAdmin(request.resource.data.tenantId)
      ) || (
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'admin' &&
        request.resource.data.status == 'active' &&
        getAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.ownerUid == uid
      );
      // Un administrador del tenant puede gestionar solo perfiles de su empresa.
      allow update: if esSuperAdmin() || (
        isTenantAdmin(resource.data.tenantId) &&
        resource.data.tenantId == request.resource.data.tenantId &&
        resource.data.uid == request.resource.data.uid &&
        resource.data.email == request.resource.data.email &&
        request.resource.data.role in ['admin', 'staff'] &&
        request.resource.data.status in ['active', 'inactive'] &&
        resource.data.uid != get(/databases/$(database)/documents/tenants/$(resource.data.tenantId)).data.ownerUid
      ) || (
        request.auth != null && request.auth.uid == uid &&
        resource.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'job', 'phone'])
      );
      allow delete: if esSuperAdmin();
    }

    // 3. Colección de Inquilinos (Tenants) - Aislamiento multi-tenant
    match /tenants/{tenantId} {
      allow read: if userBelongsToTenant(tenantId);
      allow create: if esSuperAdmin() || (
        esPersonalAutorizado() &&
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.id == tenantId &&
        request.resource.data.planStatus == 'pending_approval' &&
        request.resource.data.planId in ['starter', 'professional', 'enterprise'] &&
        request.resource.data.billingPeriod in ['monthly', 'yearly'] &&
        request.resource.data.ownerEmail == request.auth.token.email &&
        request.resource.data.requireEmailVerification == true &&
        request.resource.data.createdAt == request.time &&
        !('trialExpiresAt' in request.resource.data) &&
        !('subscriptionExpiresAt' in request.resource.data)
      );
      allow update: if esSuperAdmin();
      allow delete: if esSuperAdmin();
    }

    // Reportes de pago: el cliente solo registra solicitudes pendientes.
    // Únicamente superadmin puede aprobarlas y activar una suscripción.
    match /transfers/{transferId} {
      allow create: if esPersonalAutorizado() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        request.resource.data.tenantId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.referenceNumber is string &&
        request.resource.data.referenceNumber.size() > 0 &&
        request.resource.data.id == transferId &&
        request.resource.data.planId is string &&
        request.resource.data.billingPeriod in ['monthly', 'yearly'] &&
        exists(/databases/$(database)/documents/plans/$(request.resource.data.planId)) &&
        request.resource.data.category == get(/databases/$(database)/documents/plans/$(request.resource.data.planId)).data.category &&
        request.resource.data.amount >= (
          request.resource.data.billingPeriod == 'yearly'
            ? get(/databases/$(database)/documents/plans/$(request.resource.data.planId)).data.priceYearly * 12 - 0.005
            : get(/databases/$(database)/documents/plans/$(request.resource.data.planId)).data.priceMonthly - 0.005
        ) &&
        request.resource.data.amount <= (
          request.resource.data.billingPeriod == 'yearly'
            ? get(/databases/$(database)/documents/plans/$(request.resource.data.planId)).data.priceYearly * 12 + 0.005
            : get(/databases/$(database)/documents/plans/$(request.resource.data.planId)).data.priceMonthly + 0.005
        );
      allow read: if esSuperAdmin() || (
        esPersonalAutorizado() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        resource.data.tenantId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId
      );
      allow update, delete: if esSuperAdmin();
    }

    // 4. Colección de Planes (Lectura pública para catálogo de suscripción en landing/portal)
    match /plans/{planId} {
      allow read: if true;
      allow write: if esSuperAdmin();
    }

    // 5. Comprobantes de Transferencias Bancarias (Payment Vouchers)
    match /payment_vouchers/{voucherId} {
      allow create: if esPersonalAutorizado() && (
        esSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         request.resource.data.tenantId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId &&
         request.resource.data.status == 'pending')
      );
      allow read: if esSuperAdmin() || (
        esPersonalAutorizado() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        resource.data.tenantId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId
      );
      allow update, delete: if esSuperAdmin();
    }

    // 6. Contact Leads desde la Landing Page
    match /landing_leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
          'nombre', 'email', 'telefono', 'empresa', 'mensaje', 'fecha', 'estado'
        ]) && request.resource.data.keys().hasAll([
          'nombre', 'email', 'telefono', 'empresa', 'mensaje', 'fecha', 'estado'
        ]) &&
        request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 120 &&
        request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 254 &&
        request.resource.data.telefono is string && request.resource.data.telefono.size() <= 40 &&
        request.resource.data.empresa is string && request.resource.data.empresa.size() <= 160 &&
        request.resource.data.mensaje is string && request.resource.data.mensaje.size() > 0 && request.resource.data.mensaje.size() <= 5000 &&
        request.resource.data.fecha == request.time &&
        request.resource.data.estado == 'nuevo';
      allow read, update, delete: if esSuperAdmin();
    }

    // Denegar por defecto cualquier otra ruta no contemplada arriba.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
